{
    "experiment_name": "aya_profanity",

    "input_type": "transcript",

    "model": {
        "name": "CohereLabs/aya-expanse-8b"
    },

    "dataset": {
        "name": "mangalathkedar/multilingual-indic-profane",
        "split": "train",
        "streaming": true
    },

    "prompt": {
        "template": "profanity_detection"
    },

    "generation": {
        "max_new_tokens": 5,
        "do_sample": false
    },

    "evaluation": {
        "metric": "accuracy"
    },

    "output": {
        "prediction_file": "outputs/aya_predictions.csv",
        "metric_file": "outputs/aya_metrics.json"
    }
}
