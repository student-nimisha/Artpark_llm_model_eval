{
    "experiment_name": "gemma_profanity",

    "input_type": "transcript",

    "model": {
        "name": "google/gemma-3-4b-it",
        "torch_dtype": "bfloat16",
        "device_map": "auto",
        "trust_remote_code": false
    },

    "dataset": {
        "name": "mangalathkedar/multilingual-indic-profane",
        "split": "train",
        "streaming": true,
        "text_column": null,
        "label_column": null,
        "language_column": null
    },

    "prompt": {
        "template": "profanity_detection"
    },

    "generation": {
        "max_new_tokens": 5,
        "do_sample": false
    },

    "evaluation": {
        "metric": "accuracy",
        "max_samples": null
    },

    "output": {
        "prediction_file": "outputs/gemma_predictions.csv",
        "metric_file": "outputs/gemma_metrics.json"
    }
}
