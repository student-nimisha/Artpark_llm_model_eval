{
    "experiment_name": "gemma_1b_profanity_cpu",

    "input_type": "transcript",

    "model": {
        "name": "google/gemma-3-1b-it",
        "torch_dtype": "float32",
        "device_map": "cpu",
        "trust_remote_code": false,
        "load_in_4bit": false
    },

    "dataset": {
        "name": "mangalathkedar/multilingual-indic-profane",
        "split": "train",
        "streaming": true,
        "text_column": null,
        "label_column": null,
        "language_column": null
    },

    "prompt": {
        "template": "profanity_detection"
    },

    "generation": {
        "max_new_tokens": 5,
        "do_sample": false
    },

    "evaluation": {
        "metric": "accuracy",
        "max_samples": 200
    },

    "output": {
        "prediction_file": "outputs/gemma_1b_cpu_predictions.csv",
        "metric_file": "outputs/gemma_1b_cpu_metrics.json"
    }
}
